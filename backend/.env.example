# Copia este archivo a .env y ajusta los valores para tu entorno local.

# ── Gateway (:8080) ──────────────────────────────────────────────────────────
PRESENTATIONS_URL=http://localhost:8081
REALTIME_URL=http://localhost:8082
ROOMS_URL=http://localhost:8083
ALLOWED_ORIGINS=http://localhost:5173

# ── Presentations (:8081) ────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ── Realtime (:8082) ─────────────────────────────────────────────────────────
# PRESENTATIONS_URL se comparte con gateway

# ── Rooms (:8083) ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://spd:spd@localhost:5432/spd?sslmode=disable
# PRESENTATIONS_URL se comparte con gateway
